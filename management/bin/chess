#!/usr/bin/env php
<?php

require __DIR__.'/../vendor/autoload.php';

use Dotenv\Dotenv;
use Scacchilatorre\Management\Commands\Collect;
use Scacchilatorre\Management\Commands\Deploy;
use Scacchilatorre\Management\Commands\Migrate;
use Symfony\Component\Console\Application;

Dotenv::createImmutable(__DIR__ . '/..')->load();

$container = require __DIR__.'/../config/container.php';

$application = new Application('ScacchiLaTorre Administration');
$application->add($container->get(Migrate::class));
$application->add($container->get(Collect::class));
$application->add($container->get(Deploy::class));

$application->run();
