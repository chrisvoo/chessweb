    "description": "Migration and deployments utilities",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Scacchilatorre\\Management\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Christian Castelli",
            "email": "christian.castelli@docebo.com"
        }
    ],
    "require": {
